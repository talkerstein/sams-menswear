---
import BaseLayout from '../layouts/BaseLayout.astro';
import Testimonials from '../components/Testimonials.astro';
import FaqBlock from '../components/FaqBlock.astro';
import { reviews } from '../data/reviews.js';
import { faqs } from '../data/faqs.js';
import { clientPhotos as cp } from '../data/clientPhotos.js';

const weddingFaqs = faqs.filter((f) => f.cat === 'Weddings');

const site = 'https://customsuitandshirt.com';
const gta = ['Vaughan', 'Thornhill', 'Toronto', 'North York', 'Richmond Hill', 'Markham', 'Woodbridge'];
// Service node, provided by the #business, served across the GTA.
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${site}/wedding#service`,
  name: 'Custom Wedding Suits & Tuxedos',
  serviceType: 'Custom wedding suit and tuxedo tailoring',
  provider: { '@id': `${site}/#business` },
  areaServed: gta.map((c) => ({ '@type': 'City', name: c })),
  url: `${site}/wedding`,
  description: 'Bespoke wedding suits and tuxedos for the groom, groomsmen and both fathers, measured personally by Sam and coordinated as one party. Made to fit, never rented.',
};
---
<BaseLayout
  nav="wedding"
  title="Wedding Suits & Tuxedos · Vaughan, Thornhill & the GTA"
  description="Custom wedding suits and tuxedos for the groom, groomsmen and fathers, measured personally by Sam in Vaughan, Thornhill and across the GTA. Made to fit, never rented."
>

  <!-- PAGE HERO -->
  <section class="page-hero">
    <div class="container">
      <div data-reveal>
        <div class="eyebrow-rule">House № 01 &middot; Wedding</div>
        <h1 class="h1-split"><span class="h1-display">The suit he <em>will be remembered in.</em></span><span class="h1-sem">Custom wedding suits and tuxedos in Vaughan, Thornhill and Toronto</span></h1>
        <p class="lede">A wedding suit is the single most photographed garment of a man's life. Sam draws each one personally: lapel, cuff, button-stance and lining, from the groom's first measure to the groomsmen's last fitting.</p>
        <div class="hero-cta-row">
          <a href="/book" class="btn is-primary" data-open-booking data-no-transition>Book a Fitting</a>
          <a href="tel:+16474580711" class="hero-cta-call" data-no-transition>or call 647 · 458 · 0711</a>
        </div>
        <p class="cta-trust">★ 4.7 · 150+ Google reviews · First fitting free &amp; no-obligation · A firm price before a thread is cut</p>
        <p style="margin-top: 14px;"><a href="#party" style="font-family: var(--serif); font-style: italic; font-size: 15px; color: var(--oxblood); border-bottom: 1px solid var(--rule-strong); padding-bottom: 1px;">Booking for the whole party? Jump to the one-booking form &rarr;</a></p>
      </div>
    </div>
  </section>

  <!-- STORY + SKETCH SPLIT -->
  <section class="section tight">
    <div class="container">
      <div class="split wide-left" data-reveal>
        <div>
          <h2 class="h-2" style="text-transform: uppercase;">A wedding party, <em style="font-style: italic; font-weight: 400; text-transform: none; color: var(--oxblood);">cut from one&nbsp;hand.</em></h2>
          <p class="body-prose" style="margin-top: 24px;">
            The groom is the lead, but never the only one drawn. Sam fits the father of the groom, the father of the bride, the brothers, the best man, and the ring-bearer, measuring all of them against the same notebook, so the group photograph holds together: one cloth run, matching lapels, every shoulder sitting where it should.
          </p>
          <p class="body-prose" style="margin-top: 18px;">
            Tuxedos in midnight wool with satin peak lapels. Three-piece suits in deep navy, charcoal, oxblood, or hunter green. Morning coats for the traditional. Cummerbunds, waistcoats, bow ties and braces, all from the house cloth.
          </p>
          <p style="margin-top: 32px;">
            <a href="/book" data-open-booking data-no-transition style="font-family: var(--serif); font-style: italic; letter-spacing: 0.18em; text-transform: uppercase; font-size: 14px; color: var(--ink); border-bottom: 1px solid var(--rule-strong); padding-bottom: 2px;">Begin a wedding consultation&nbsp;&nbsp;&rarr;</a>
          </p>
        </div>
        <div>
          <figure class="wed-portrait">
            <img src="/media/art/wedding-groom.webp" alt="The groom in a deep-navy three-piece wedding suit, drawn at the studio" loading="lazy"/>
            <figcaption>№ 01 · The Groom</figcaption>
          </figure>
        </div>
      </div>
    </div>
  </section>

  <!-- REAL WEDDINGS. Photographs taken by Sam's own clients and shared with
       permission. Not styled, not staged, not ours: theirs. -->
  <section class="section tight">
    <div class="container">
      <div class="section-head" data-reveal>
        <div class="chapter-no">Their day</div>
        <h2 class="h-1" style="text-transform: uppercase; max-width: 20ch;">Suits that <em>went to weddings.</em></h2>
        <div class="right">Photographed by the grooms</div>
      </div>
      <p class="body-prose" data-reveal style="max-width: 56ch; margin-top: 8px;">
        Not a styled shoot. These were taken by the men who wore the suits and posted them themselves, which is the only kind of photograph worth showing you.
      </p>
      <div class="cli-grid" data-reveal-stagger>
        <figure class="cli-shot cli-shot--tall">
          <img src={cp.weddingMorning.src} alt={cp.weddingMorning.alt} width={cp.weddingMorning.w} height={cp.weddingMorning.h} loading="lazy"/>
          <figcaption>The morning of &middot; {cp.weddingMorning.credit}</figcaption>
        </figure>
        <figure class="cli-shot cli-shot--tall">
          <img src={cp.weddingCouple.src} alt={cp.weddingCouple.alt} width={cp.weddingCouple.w} height={cp.weddingCouple.h} loading="lazy"/>
          <figcaption>Grey three-piece, and the dogs &middot; {cp.weddingCouple.credit}</figcaption>
        </figure>
        <figure class="cli-shot cli-shot--tall">
          <img src={cp.weddingFirstDance.src} alt={cp.weddingFirstDance.alt} width={cp.weddingFirstDance.w} height={cp.weddingFirstDance.h} loading="lazy"/>
          <figcaption>The first dance &middot; {cp.weddingFirstDance.credit}</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- FABRIC LIBRARY -->
  <section class="section">
    <div class="container">
      <div class="section-head" data-reveal>
        <div class="chapter-no">No. 02</div>
        <h2 class="h-1" style="text-transform: uppercase; max-width: 16ch;">The wedding <em>cloth library.</em></h2>
        <div class="right">House cloths</div>
      </div>

      <div class="swatch-rail" data-reveal>
        <div class="swatch swatch--navy swatch--dark"><div class="swatch__meta">Worsted suiting</div><div class="swatch__name">Midnight Navy</div></div>
        <div class="swatch swatch--charcoal swatch--dark"><div class="swatch__meta">Chalk-stripe worsted</div><div class="swatch__name">Charcoal Chalk</div></div>
        <div class="swatch swatch--oxblood swatch--dark"><div class="swatch__meta">Cotton velvet</div><div class="swatch__name">Oxblood Velvet</div></div>
        <div class="swatch swatch--herringbone swatch--dark"><div class="swatch__meta">Herringbone</div><div class="swatch__name">Hunter Green</div></div>
        <div class="swatch swatch--espresso swatch--dark"><div class="swatch__meta">Worsted flannel</div><div class="swatch__name">Tobacco Brown</div></div>
        <div class="swatch swatch--cream"><div class="swatch__meta">Linen / silk</div><div class="swatch__name">Ivory Dinner</div></div>
        <div class="swatch swatch--check swatch--dark"><div class="swatch__meta">Glen check</div><div class="swatch__name">Country Estate</div></div>
      </div>
      <p class="chapter-no" style="margin-top: 24px; text-align: center;">&middot; Scroll for more &middot;</p>
    </div>
  </section>

  <!-- LOOKBOOK -->
  <section class="section">
    <div class="container">
      <div class="section-head" data-reveal>
        <div class="chapter-no">No. 03</div>
        <h2 class="h-1" style="text-transform: uppercase; max-width: 18ch;">From the <em>wedding folio.</em></h2>
        <div class="right">Grooms, parties &amp; black tie</div>
      </div>
      <div class="lookbook" data-reveal>
        <div class="lb-tile lb-1 has-photo"><img src="/media/art/wedding-groomsmen.webp" alt="A groom and his groomsmen in coordinated navy suits" loading="lazy"/><div class="placeholder"><div class="corner">Folio · I</div><div class="label">The wedding party</div><div class="meta">Groom &amp; groomsmen, coordinated</div></div></div>
        <div class="lb-tile lb-2 has-photo"><img src="/media/art/wedding-tuxedo.webp" alt="A black tuxedo with satin peak lapel and bow tie" loading="lazy"/><div class="placeholder"><div class="corner">Folio · II</div><div class="label">Black tie</div><div class="meta">Satin peak lapel &amp; bow</div></div></div>
        <div class="lb-tile lb-3 has-photo"><img src="/media/art/wedding-father-son.webp" alt="A groom and his father in coordinated navy suits" loading="lazy"/><div class="placeholder"><div class="corner">Folio · III</div><div class="label">Father &amp; son</div><div class="meta">The morning of</div></div></div>
        <div class="lb-tile lb-4 has-photo"><img src="/media/art/garment-dress-shirt.webp" alt="Sketch of a custom dress shirt" loading="lazy"/><div class="placeholder"><div class="corner">Folio · IV</div><div class="label">Custom dress shirt</div><div class="meta">Cut from your pattern</div></div></div>
        <div class="lb-tile lb-5 has-photo"><img src="/media/art/wedding-boutonniere.webp" alt="Sketch of a boutonnière pinned to a wedding-suit lapel" loading="lazy"/><div class="placeholder"><div class="corner">Folio · V</div><div class="label">The boutonnière</div><div class="meta">The morning of</div></div></div>
        <div class="lb-tile lb-6 has-photo"><img src="/media/art/business-lining.webp" alt="Sketch of a jacket folded open, showing the oxblood lining with Sam's gold cap-and-bow-tie mark" loading="lazy"/><div class="placeholder"><div class="corner">Folio · VI</div><div class="label">The lining &amp; the mark</div><div class="meta">Your private signature</div></div></div>
        <div class="lb-tile lb-7 has-photo"><img src="/media/sam/sam-fitting-cuff.webp" alt="Sam measuring a groom's cuff at a fitting, working buttonholes visible on the navy sleeve" loading="lazy"/><div class="placeholder"><div class="corner">Folio · VII</div><div class="label">The last fitting</div><div class="meta">Before the day</div></div></div>
        <div class="lb-tile lb-8 has-photo"><img src="/media/art/custom-wardrobe.webp" alt="Sketch of five tailored jackets hanging on one garment rail" loading="lazy"/><div class="placeholder"><div class="corner">Folio · VIII</div><div class="label">The party's rail</div><div class="meta">One cloth run, every man</div></div></div>
        <div class="lb-tile lb-9 has-photo"><img src="/media/art/garment-outerwear.webp" alt="Sketch of a tailored overcoat" loading="lazy"/><div class="placeholder"><div class="corner">Folio · IX</div><div class="label">The overcoat</div><div class="meta">Winter weddings</div></div></div>
      </div>
    </div>
  </section>

  <!-- THE PROMISE / DETAILS -->
  <section class="section"
           style="background: linear-gradient(180deg, transparent 0%, var(--paper-cream) 50%, transparent 100%);">
    <div class="container">
      <div class="section-head" data-reveal>
        <div class="chapter-no">No. 04</div>
        <h2 class="h-1" style="text-transform: uppercase; max-width: 18ch;">What's <em>included.</em></h2>
        <div class="right">From measure to morning-of</div>
      </div>

      <div class="feature-grid cols-3" data-reveal-stagger>
        <div>
          <div class="feature-num">№ I</div>
          <h3 class="h-3">Personal consultation</h3>
          <p class="body-prose" style="margin-top: 12px;">A proper sit-down about the wedding: the venue, the season, the colour story, the bride's gown, the photographs you want in twenty years.</p>
        </div>
        <div>
          <div class="feature-num">№ II</div>
          <h3 class="h-3">Twenty-six measurements</h3>
          <p class="body-prose" style="margin-top: 12px;">Taken in person by Sam. Re-checked at each fitting. Your suit is made to those numbers, not pulled from a rack or sized to an average.</p>
        </div>
        <div>
          <div class="feature-num">№ III</div>
          <h3 class="h-3">Three fittings</h3>
          <p class="body-prose" style="margin-top: 12px;">Basted, intermediate, and final. The garment learns the shape of you across each one. Tiny corrections (drop of shoulder, sleeve pitch, trouser break) are made by hand.</p>
        </div>
        <div>
          <div class="feature-num">№ IV</div>
          <h3 class="h-3">Groomsmen co‑ordinated</h3>
          <p class="body-prose" style="margin-top: 12px;">Up to ten groomsmen drawn from the same fabric run, with consistent lapel, button and pocket detail, so the whole row looks planned to the last button.</p>
        </div>
        <div>
          <div class="feature-num">№ V</div>
          <h3 class="h-3">Pressed &amp; delivered</h3>
          <p class="body-prose" style="margin-top: 12px;">Pressed the morning of, boxed in tissue, hand-delivered to your hotel or home if you're in Vaughan or Thornhill. We carry a kit for last-minute thread emergencies.</p>
        </div>
        <div>
          <div class="feature-num">№ VI</div>
          <h3 class="h-3">Lifetime adjustments</h3>
          <p class="body-prose" style="margin-top: 12px;">Bodies change. So do anniversaries. Bring the suit back any time for a re-press, a small letting-out, or a quiet refresh. The pattern remains in our notebook.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- WHY NOT RENT -->
  <section class="section"
           style="background: linear-gradient(180deg, transparent 0%, var(--paper-cream) 40%, transparent 100%);">
    <div class="container">
      <div class="section-head" data-reveal>
        <div class="chapter-no">No. 05</div>
        <h2 class="h-1" style="text-transform: uppercase; max-width: 20ch;">Why not just <em>rent it?</em></h2>
        <div class="right">The case against the rental</div>
      </div>

      <p class="body-prose" data-reveal style="max-width: 58ch; margin-bottom: 40px; font-size: 20px;">
        A rental feels cheaper on the day. Then the photos come back. A tuxedo or suit rental is cut for the average of every man who wore it before you, and every compromise ends up in the album your family keeps forever. Here's the comparison, line by line.
      </p>

      <div class="feature-grid cols-2" data-reveal-stagger>
        <div style="border-top: 2px solid var(--rule-strong); padding-top: 20px;">
          <div class="feature-num" style="color: var(--ink-mute);">The rental</div>
          <h3 class="h-3" style="margin-bottom: 16px;">What you actually get</h3>
          <ul class="prose-list">
            <li>Cut for a crowd and adjusted toward you. Never truly your fit.</li>
            <li>The same handful of styles half the season's weddings wear.</li>
            <li>Day-of risk: wrong size shipped, last wearer's stain, no time to fix it.</li>
            <li>A few hundred dollars for one night, and you keep nothing.</li>
            <li>No tailor of your own when something goes wrong.</li>
          </ul>
        </div>
        <div style="border-top: 2px solid var(--oxblood); padding-top: 20px;">
          <div class="feature-num" style="color: var(--oxblood);">Made by Sam</div>
          <h3 class="h-3" style="margin-bottom: 16px;">What you keep</h3>
          <ul class="prose-list">
            <li>Built to your twenty-six measurements. The shoulders are yours.</li>
            <li>Your cloth, your lapel, your details. One of one.</li>
            <li>Three fittings and a tailor on call right up to the morning of.</li>
            <li>Yours forever, worn again at every event after the wedding.</li>
            <li>Divided across those wears, it costs less than renting twice.</li>
          </ul>
        </div>
      </div>

      <p data-reveal style="margin-top: 36px;">
        <a href="/guides/custom-vs-rental-wedding-suit" style="font-family: var(--serif); font-style: italic; letter-spacing: 0.18em; text-transform: uppercase; font-size: 14px; color: var(--ink); border-bottom: 1px solid var(--rule-strong); padding-bottom: 2px;">Read the custom-vs-rental math&nbsp;&nbsp;&rarr;</a>
      </p>
    </div>
  </section>

  <!-- WHERE THE GROOMS COME FROM. Service area only: no venue is named and no
       venue relationship is claimed or implied. Sam has no dealings with halls. -->
  <section class="section tight">
    <div class="container">
      <div class="section-head" data-reveal>
        <div class="chapter-no">No. 06</div>
        <h2 class="h-1" style="text-transform: uppercase; max-width: 18ch;">Married <em>across the GTA.</em></h2>
        <div class="right">Wherever the hall turns out to be</div>
      </div>
      <p class="body-prose" data-reveal style="max-width: 58ch; font-size: 19px;">
        Your family books the hall. That part has nothing to do with us. Ours is the half nobody thinks about until the photographs come back: the grooms who drive to this studio come from all over the region, and they get married all over it too.
      </p>
      <div class="wed-venues" data-reveal>
        <span class="wed-venue">Vaughan<em>&amp; Maple</em></span>
        <span class="wed-venue">Thornhill<em>&amp; Richmond Hill</em></span>
        <span class="wed-venue">Woodbridge<em>&amp; Kleinburg</em></span>
        <span class="wed-venue">Toronto<em>&amp; North York</em></span>
        <span class="wed-venue">Markham<em>&amp; the east end</em></span>
      </div>
      <p class="wed-venues-note" data-reveal>
        Book a ballroom, a shul hall, a backyard or a golf club; it makes no difference to the cutting. We have no arrangement with any venue and never will. Our only job is that you outdress the room your family chose.
      </p>
    </div>
  </section>

  <!-- TESTIMONIALS -->
  <section class="section tight">
    <div class="container">
      <div class="section-head" data-reveal>
        <div class="chapter-no">No. 07</div>
        <h2 class="h-1" style="text-transform: uppercase; max-width: 18ch;">From the <em>groom's side.</em></h2>
        <div class="right">Letters, after the wedding</div>
      </div>
      <Testimonials items={[reviews[1], reviews[3], reviews[5]]} />
    </div>
  </section>

  <!-- WEDDING LIBRARY + FAQ -->
  <section class="section">
    <div class="container">
      <div class="section-head" data-reveal>
        <div class="chapter-no">No. 08</div>
        <h2 class="h-1" style="text-transform: uppercase; max-width: 20ch;">The wedding <em>reading room.</em></h2>
        <div class="right">Everything a groom needs to know</div>
      </div>

      <div class="wed-guides" data-reveal-stagger>
        <a class="wed-guide" href="/guides/the-grooms-suit">
          <span class="wed-guide__k">The Groom</span>
          <span class="wed-guide__t">The groom's suit, done right</span>
          <span class="wed-guide__d">Colour, cloth, custom vs rental, and the timeline for the outfit you'll see in photos forever.</span>
        </a>
        <a class="wed-guide" href="/guides/the-custom-tuxedo">
          <span class="wed-guide__k">Tuxedos</span>
          <span class="wed-guide__t">The custom tuxedo</span>
          <span class="wed-guide__d">Why a tuxedo is the last thing you should rent, and what a made one gets you.</span>
        </a>
        <a class="wed-guide" href="/guides/coordinating-groomsmen">
          <span class="wed-guide__k">Groomsmen</span>
          <span class="wed-guide__t">Coordinating the party</span>
          <span class="wed-guide__d">Matching vs coordinating, setting the groom apart, and the out-of-town problem.</span>
        </a>
        <a class="wed-guide" href="/guides/father-of-the-bride-and-groom-suit">
          <span class="wed-guide__k">The Fathers</span>
          <span class="wed-guide__t">Father of the bride &amp; groom</span>
          <span class="wed-guide__d">How to dress the dads and fathers-in-law so they look like part of the party, not guests at it.</span>
        </a>
        <a class="wed-guide" href="/guides/black-tie-wedding-attire">
          <span class="wed-guide__k">Dress Codes</span>
          <span class="wed-guide__t">Black tie, decoded</span>
          <span class="wed-guide__d">What black tie, black tie optional and formal actually mean, and how to nail each.</span>
        </a>
        <a class="wed-guide" href="/guides/wedding-suit-timeline">
          <span class="wed-guide__k">Timeline</span>
          <span class="wed-guide__t">The wedding suit timeline</span>
          <span class="wed-guide__d">When to start, fitting by fitting, so nothing is rushed near the date.</span>
        </a>
      </div>

      <div data-reveal style="max-width: 760px; margin-top: 64px;">
        <div class="eyebrow-rule">Wedding questions</div>
        <h3 class="h-2" style="margin-bottom: 24px;">Grooms, groomsmen &amp; fathers, <em>answered.</em></h3>
        <FaqBlock items={weddingFaqs} />
      </div>
    </div>
  </section>

  <!-- WHOLE-PARTY BOOKING -->
  <section class="section" id="party">
    <div class="container">
      <div class="section-head" data-reveal>
        <div class="chapter-no">No. 09</div>
        <h2 class="h-1" style="text-transform: uppercase; max-width: 20ch;">The whole party, <em>one booking.</em></h2>
        <div class="right">Groom · groomsmen · both fathers</div>
      </div>
      <div class="feature-grid cols-2" data-reveal>
        <div>
          <p class="body-prose" style="font-size: 19px;">
            Coordinating five men and two fathers is a project, unless one tailor measures all of them against the same notebook. Tell us the date and the size of the party, and Sam calls you back to plan it: one group fitting at the studio, the whole party booked back to back. Out-of-town groomsmen get a measuring guide and a video walkthrough, then a fitting when they land.
          </p>
          <p class="body-prose" style="margin-top: 16px; font-size: 17px; color: var(--ink-mute);">
            The planning conversation is free, like every first consultation, and every man in the party gets a firm, per-man price before anything is cut.
          </p>
        </div>
        <div class="dz-lead" style="margin-top: 0;">
          <h3 class="h-4" style="text-transform: uppercase; color: var(--navy);">Plan the party fitting</h3>
          <form class="dz-form" data-party-form>
            <input type="text" name="name" placeholder="Your name" autocomplete="name" required/>
            <input type="tel" name="phone" placeholder="Phone" autocomplete="tel" required/>
            <input type="email" name="email" placeholder="Email" autocomplete="email"/>
            <label class="dz-when">Wedding date
              <input type="date" name="weddingdate" aria-label="Wedding date"/>
            </label>
            <label class="dz-when" style="grid-column: 1 / -1;">How many are we dressing?
              <select name="partysize" aria-label="Party size">
                <option value="groom">Just the groom (for now)</option>
                <option value="2-4">2–4 · groom &amp; a few</option>
                <option value="5-7" selected>5–7 · the party &amp; a father</option>
                <option value="8+">8+ · the whole line, both fathers</option>
              </select>
            </label>
            <label class="dz-when" style="grid-column: 1 / -1;">Any groomsmen out of town?
              <select name="outoftown" aria-label="Out of town groomsmen">
                <option value="no">No, everyone's local</option>
                <option value="yes">Yes, some fly in</option>
              </select>
            </label>
            <input type="text" name="company" class="dz-hp" tabindex="-1" autocomplete="off" aria-hidden="true"/>
            <button type="submit" class="btn is-dark" style="color: var(--ink); border-color: var(--ink);">Have Sam call about the party</button>
          </form>
          <div class="dz-ack" data-party-ack hidden>
            <div class="dz-ack-seal">✓</div>
            <p data-party-lead><strong>Got it.</strong> Sam will call to plan the party fitting: <span data-party-summary></span>.</p>
            <p class="dz-fallback" data-party-fallback hidden style="font-size:14px;"></p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- BOOKING CTA -->
  <section class="section flush">
    <div class="container">
      <div class="booking-block" data-reveal>
        <div>
          <div class="eyebrow-rule" style="color: var(--gold-soft); margin-bottom: 28px;">
            <span style="background: var(--navy-deep);">Wedding consultations · By appointment</span>
          </div>
          <h2 class="h-1">Begin a <em>wedding fitting.</em></h2>
          <p class="lede" style="margin-top: 24px;">
            First consultations are usually 9–12 months before the wedding. Bring a photograph of the bride's gown, the venue, and any suit you've loved. Or bring none of those things, and we'll start from a blank page.
          </p>
        </div>
        <div class="actions">
          <a href="/book" class="btn is-primary" data-open-booking data-no-transition>Book a Wedding Fitting</a>
          <div class="contact-tag" style="margin-top: 12px;">
            Or call the studio
            <div class="num">647 · 458 · 0711</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />

  <script>
    // Whole-party booking → shared SamsLead pipe as a 'wedding-party' lead.
    const form = document.querySelector('[data-party-form]');
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const val = (n) => { const el = form.querySelector('[name="' + n + '"]'); return el ? el.value.trim() : ''; };
      // Honeypot: silently pretend success for bots.
      if (val('company')) { form.hidden = true; const a = document.querySelector('[data-party-ack]'); if (a) a.hidden = false; return; }
      const name = val('name'), phone = val('phone'), email = val('email');
      const weddingdate = val('weddingdate'), partysize = val('partysize'), outoftown = val('outoftown');
      if (!name || !phone) { form.querySelector(!name ? '[name="name"]' : '[name="phone"]').focus(); return; }
      // Urgency: weddings plan 9-12 months out, so a near date is a call-now lead.
      let urgency = 'nurture';
      if (weddingdate) {
        const days = Math.round((new Date(weddingdate) - new Date()) / 86400000);
        urgency = days <= 90 ? 'HOT: call now' : days <= 270 ? 'warm' : 'nurture';
      }
      const size = { 'groom': 'groom only', '2-4': 'party of 2-4', '5-7': 'party of 5-7', '8+': 'party of 8+' }[partysize] || partysize;
      const summary = size + (weddingdate ? ', wedding ' + weddingdate : '') + (outoftown === 'yes' ? ', out-of-town groomsmen' : '');
      const btn = form.querySelector('button[type="submit"]');
      if (btn) { btn.disabled = true; btn.textContent = 'Sending…'; }
      let result = { ok: false };
      try {
        result = (window.SamsLead && window.SamsLead.send)
          ? await window.SamsLead.send('wedding-party', { name, phone, email, weddingdate, partysize: size, outoftown, urgency })
          : { ok: false };
      } catch (err) { result = { ok: false }; }
      const ack = document.querySelector('[data-party-ack]');
      const sum = document.querySelector('[data-party-summary]');
      if (sum) sum.textContent = summary;
      if (!result.ok && window.SamsLead) {
        // Fallback: we did NOT reach Sam automatically, so offer the direct paths.
        const lead = document.querySelector('[data-party-lead]');
        if (lead) lead.innerHTML = '<strong>Almost there.</strong> One tap reaches Sam directly: <span>' + summary + '</span>';
        const wa = window.SamsLead.whatsapp('Hi Sam, wedding party booking: ' + summary + '. From ' + name + ', ' + phone);
        const mail = window.SamsLead.mailto('Wedding party booking from ' + name, { Name: name, Phone: phone, Email: email, 'Wedding date': weddingdate, Party: size, 'Out-of-town': outoftown });
        const fb = document.querySelector('[data-party-fallback]');
        if (fb) { fb.innerHTML = 'Reach Sam right now: <a href="' + wa + '" target="_blank" rel="noopener">WhatsApp the details</a>, <a href="' + mail + '">email them</a>, or <a href="tel:' + window.SamsLead.PHONE + '">call ' + window.SamsLead.PHONE_DISP + '</a>.'; fb.hidden = false; }
      }
      form.hidden = true;
      if (ack) ack.hidden = false;
    });
  </script>

</BaseLayout>
