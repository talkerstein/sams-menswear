---
import BaseLayout from '../layouts/BaseLayout.astro';
import Testimonials from '../components/Testimonials.astro';
import FaqBlock from '../components/FaqBlock.astro';
import { reviews } from '../data/reviews.js';

// Page-specific FAQs. Every answer is a fact Sam confirmed himself:
// turnaround, the 50/50 split, alterations, canvas, the kept pattern.
const customFaqs = [
  { q: 'What is the difference between bespoke and made-to-measure, and which do I need?',
    a: "Made-to-measure adjusts an existing pattern to your numbers; bespoke drafts a pattern from nothing but your body. Sam does both, and he'll tell you which one your build actually needs. Most men are well served by made-to-measure, and he says so rather than selling up." },
  { q: 'How long does a custom shirt or suit take?',
    a: "Two to three weeks for a shirt, three to four for a suit. If something is urgent, twelve days is the fastest Sam will go, and only when the cloth is on hand." },
  { q: 'Do I have to be measured again every time I order?',
    a: "No. Your pattern is drawn once and kept. After the first visit a reorder is a phone call: name the cloth and the collar, and it's on your back in two to three weeks." },
  { q: 'Are your jackets fused or canvassed?',
    a: "Sam does not fuse suits. Half canvas is the default, and full canvas goes into the dearer cloths. A fused jacket is the one that bubbles across the chest after a couple of seasons." },
  { q: 'What do I pay, and when?',
    a: "Half when the cloth is chosen, half on delivery. You get one firm price for the exact garment before anything is cut, and the first half covers cloth that has been cut to you and can't be resold." },
  { q: 'Are alterations included?',
    a: "Alterations that are part of getting the garment right are included in the price, not billed at the end. If your body changes a year or two later, that's separate work and Sam will quote it before he starts." },
  { q: 'Can Sam alter a suit I already own?',
    a: "Often, yes. Sleeves, hems, waist and trouser work are straightforward. Some suits are worth altering and some are cheaper to replace than to rescue; bring it in and you'll be told which one you have." },
  { q: 'Where does the fitting happen?',
    a: "At the studio, 318 Charlton Avenue in Vaughan, on the Thornhill line, by appointment so the room and the hour are yours. Parking is at the door." },
];

const site = 'https://customsuitandshirt.com';
const gta = ['Vaughan', 'Thornhill', 'Toronto', 'North York', 'Richmond Hill', 'Markham', 'Woodbridge'];
// Service node, provided by the #business, served across the GTA.
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${site}/custom#service`,
  name: 'Custom Suits & Shirts',
  serviceType: 'Bespoke and made-to-measure tailoring',
  provider: { '@id': `${site}/#business` },
  areaServed: gta.map((c) => ({ '@type': 'City', name: c })),
  url: `${site}/custom`,
  description: 'A wardrobe of custom suits, jackets, trousers and shirts drafted from one personal pattern that Sam keeps on file. Measured by hand at the Vaughan studio, reordered in days.',
};
---
<BaseLayout
  nav="custom"
  title="Custom Suits & Shirts in Vaughan & the GTA · Sam's Menswear"
  description="Custom suits, jackets, trousers and shirts drafted from one personal pattern, measured and fitted at Sam's studio in Vaughan, serving Thornhill, Toronto & the GTA."
>

  <section class="page-hero">
    <div class="container">
      <div data-reveal>
        <div class="eyebrow-rule">House № 03 &middot; Custom</div>
        <h1>One pattern. <em>One body.</em></h1>
        <p class="lede">A wardrobe of suits, jackets, trousers and shirts, all drafted from a single pattern of your shoulders, your stance, the way you actually move through a day.</p>
        <div class="hero-cta-row">
          <a href="/book" class="btn is-primary" data-open-booking data-no-transition>Book a Fitting</a>
          <a href="tel:+16474580711" class="hero-cta-call" data-no-transition>or call 647 · 458 · 0711</a>
        </div>
        <p class="cta-trust">★ 4.7 · 150+ Google reviews · First fitting free &amp; no-obligation</p>
      </div>
    </div>
  </section>

  <section class="section tight">
    <div class="container">
      <div class="split wide-left" data-reveal>
        <div>
          <h2 class="h-2" style="text-transform: uppercase;">A wardrobe drawn <em style="font-style: italic; font-weight: 400; text-transform: none; color: var(--oxblood);">from one&nbsp;notebook.</em></h2>
          <p class="body-prose" style="margin-top: 24px;">
            Custom work is not a single garment. It is a personal pattern that Sam keeps for you: drawn in pencil, updated at every visit, used to draft every shirt, every trouser, every jacket you'll commission in the years to come.
          </p>
          <p class="body-prose" style="margin-top: 18px;">
            A first shirt takes two to three weeks, and so does the twentieth. What the pattern changes is everything that happens before the cutting. You name a cloth and a collar down the phone, and nobody has to measure you again.
          </p>
        </div>
        <div>
          <div style="aspect-ratio: 4 / 5; background: var(--paper-cream); border: 1px solid var(--rule); position: relative; overflow: hidden;">
            <div class="crop-marks"></div>
            <img src="/media/art/custom-wardrobe.webp" alt="Sketch of a wooden garment rail holding five tailored jackets: navy, charcoal, oxblood, hunter green and grey" width="900" height="1350" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover;" loading="lazy"/>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Options: Collar / Cuff / Body -->
  <section class="section">
    <div class="container">
      <div class="section-head" data-reveal>
        <div class="chapter-no">No. 02</div>
        <h2 class="h-1" style="text-transform: uppercase; max-width: 18ch;">Drawn to <em>your specification.</em></h2>
        <div class="right">A short menu, infinite combinations</div>
      </div>

      <div data-reveal-stagger class="rgrid rgrid-3" style="margin-top: clamp(40px, 5vw, 72px);">

        <!-- Collars -->
        <div>
          <h3 class="h-3" style="text-transform: uppercase; color: var(--navy);">Collars</h3>
          <figure class="opt-photo" style="margin-top: 18px;">
            <img src="/media/sam/sam-collar.webp" alt="Sam taking a neck measurement with a tape at the collar of a client's navy suit, in the Vaughan studio" width="1280" height="851" loading="lazy"/>
          </figure>
          <div style="margin-top: 18px; display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
            <div>
              <svg viewBox="0 0 80 60" fill="none" stroke="var(--ink)" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" style="width: 100%;">
                <path d="M20 40 L 12 22 L 40 12 L 68 22 L 60 40 L 40 30 Z"/>
              </svg>
              <div class="small-tag" style="margin-top: 8px;">Spread</div>
            </div>
            <div>
              <svg viewBox="0 0 80 60" fill="none" stroke="var(--ink)" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" style="width: 100%;">
                <path d="M28 40 L 22 22 L 40 14 L 58 22 L 52 40 L 40 30 Z"/>
              </svg>
              <div class="small-tag" style="margin-top: 8px;">Point</div>
            </div>
            <div>
              <svg viewBox="0 0 80 60" fill="none" stroke="var(--ink)" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" style="width: 100%;">
                <path d="M14 40 L 6 24 L 40 12 L 74 24 L 66 40 L 40 30 Z"/>
              </svg>
              <div class="small-tag" style="margin-top: 8px;">Cutaway</div>
            </div>
            <div>
              <svg viewBox="0 0 80 60" fill="none" stroke="var(--ink)" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" style="width: 100%;">
                <path d="M22 40 L 18 22 L 40 12 L 62 22 L 58 40 L 40 30 Z"/>
                <circle cx="32" cy="34" r="1.4" fill="var(--ink)"/>
                <circle cx="48" cy="34" r="1.4" fill="var(--ink)"/>
              </svg>
              <div class="small-tag" style="margin-top: 8px;">Button-down</div>
            </div>
          </div>
        </div>

        <!-- Cuffs -->
        <div>
          <h3 class="h-3" style="text-transform: uppercase; color: var(--navy);">Cuffs</h3>
          <figure class="opt-photo opt-photo--low" style="margin-top: 18px;">
            <img src="/media/sam/sam-fitting-cuff.webp" alt="Sam measuring a client's cuff, the working buttonholes on the navy sleeve visible under the tape" width="1100" height="1653" loading="lazy"/>
          </figure>
          <div style="margin-top: 18px; display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
            <div>
              <svg viewBox="0 0 80 60" fill="none" stroke="var(--ink)" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" style="width: 100%;">
                <path d="M14 14 L 66 14 L 66 46 L 14 46 Z"/>
                <circle cx="20" cy="30" r="1.4" fill="var(--ink)"/>
              </svg>
              <div class="small-tag" style="margin-top: 8px;">One-button</div>
            </div>
            <div>
              <svg viewBox="0 0 80 60" fill="none" stroke="var(--ink)" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" style="width: 100%;">
                <path d="M14 14 L 66 14 L 66 46 L 14 46 Z"/>
                <circle cx="20" cy="24" r="1.4" fill="var(--ink)"/>
                <circle cx="20" cy="36" r="1.4" fill="var(--ink)"/>
              </svg>
              <div class="small-tag" style="margin-top: 8px;">Two-button</div>
            </div>
            <div>
              <svg viewBox="0 0 80 60" fill="none" stroke="var(--ink)" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" style="width: 100%;">
                <path d="M14 14 L 66 14 L 70 30 L 66 46 L 14 46 Z"/>
                <circle cx="20" cy="30" r="1.4" fill="var(--ink)"/>
              </svg>
              <div class="small-tag" style="margin-top: 8px;">Mitred</div>
            </div>
            <div>
              <svg viewBox="0 0 80 60" fill="none" stroke="var(--ink)" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" style="width: 100%;">
                <path d="M14 14 L 66 14 L 66 46 L 14 46 Z M 14 30 L 24 30 M 56 30 L 66 30"/>
                <circle cx="14" cy="30" r="1.6" fill="var(--gold)"/>
                <circle cx="66" cy="30" r="1.6" fill="var(--gold)"/>
              </svg>
              <div class="small-tag" style="margin-top: 8px;">French (link)</div>
            </div>
          </div>
        </div>

        <!-- Detail options -->
        <div>
          <h3 class="h-3" style="text-transform: uppercase; color: var(--navy);">Personal marks</h3>
          <figure class="opt-photo opt-photo--low" style="margin-top: 18px;">
            <img src="/media/sam/sam-fitting-shoulder.webp" alt="Sam measuring a client's sleeve length, the shirt cuff monogrammed at the wrist" width="1100" height="1653" loading="lazy"/>
          </figure>
          <div style="margin-top: 18px; display: flex; flex-direction: column; gap: 14px;">
            <div style="display: flex; align-items: baseline; gap: 14px;">
              <span style="font-family: var(--serif); font-style: italic; color: var(--gold); font-size: 14px; letter-spacing: 0.32em; text-transform: uppercase; min-width: 60px;">No. I</span>
              <span>Three-letter monogram, hand-stitched on the cuff or breast in oxblood or gold thread.</span>
            </div>
            <div style="display: flex; align-items: baseline; gap: 14px;">
              <span style="font-family: var(--serif); font-style: italic; color: var(--gold); font-size: 14px; letter-spacing: 0.32em; text-transform: uppercase; min-width: 60px;">No. II</span>
              <span>Contrast collar &amp; cuff stand: Bengal stripe body with white collar, oxford weave with chambray collar.</span>
            </div>
            <div style="display: flex; align-items: baseline; gap: 14px;">
              <span style="font-family: var(--serif); font-style: italic; color: var(--gold); font-size: 14px; letter-spacing: 0.32em; text-transform: uppercase; min-width: 60px;">No. III</span>
              <span>Mother-of-pearl, horn, or matched cloth-covered buttons. The detail no one notices on a Tuesday but you notice on a Friday.</span>
            </div>
            <div style="display: flex; align-items: baseline; gap: 14px;">
              <span style="font-family: var(--serif); font-style: italic; color: var(--gold); font-size: 14px; letter-spacing: 0.32em; text-transform: uppercase; min-width: 60px;">No. IV</span>
              <span>Family crest, dedication, or wedding date stitched on the inside placket, visible only to the wearer.</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Page-specific conversion: the terms a custom buyer is actually
           weighing at this point, in Sam's confirmed numbers. -->
      <div class="pillar-cta" data-reveal>
        <div>
          <div class="eyebrow-rule">Before you decide</div>
          <h3 class="h-2" style="margin-top: 14px; text-transform: none;">Pick the collar. <em style="font-style: italic; font-weight: 400; color: var(--oxblood);">Sam draws the rest.</em></h3>
          <ul class="pillar-cta__terms">
            <li><b>Shirts</b> <span>Two to three weeks, first one and twentieth alike.</span></li>
            <li><b>Suits</b> <span>Three to four weeks on the bench. Twelve days if it's an emergency and the cloth is in.</span></li>
            <li><b>Payment</b> <span>Half when the cloth is chosen, half on delivery. You see the whole number first.</span></li>
            <li><b>Alterations</b> <span>Part of the price. Not a line item at the end.</span></li>
            <li><b>After that</b> <span>Your pattern is kept, so the next one is a phone call.</span></li>
          </ul>
        </div>
        <div class="pillar-cta__act">
          <a href="/book" class="btn is-primary" data-open-booking data-no-transition>Start your pattern</a>
          <a href="/design" class="btn" data-no-transition>Draw it first &rarr;</a>
          <p class="pillar-cta__note">Ninety minutes at the studio, and it costs nothing. Bring the shirt you wear most and Sam will tell you exactly where it's failing you.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- The pattern process -->
  <section class="section"
           style="background: linear-gradient(180deg, transparent 0%, var(--paper-cream) 50%, transparent 100%);">
    <div class="container">
      <div class="section-head" data-reveal>
        <div class="chapter-no">No. 03</div>
        <h2 class="h-1" style="text-transform: uppercase; max-width: 18ch;">The <em>pattern</em>, kept on paper.</h2>
        <div class="right">Yours, indefinitely</div>
      </div>

      <div class="feature-grid cols-4" data-reveal-stagger>
        <div>
          <div class="feature-num">№ I</div>
          <h3 class="h-3">First Visit</h3>
          <p class="body-prose" style="margin-top: 12px;">Twenty-six measurements taken, your stance, posture, and shoulder slope drawn into the notebook by Sam himself.</p>
        </div>
        <div>
          <div class="feature-num">№ II</div>
          <h3 class="h-3">First Garment</h3>
          <p class="body-prose" style="margin-top: 12px;">Cut, basted, fitted, adjusted, finished. The pattern earns its corrections in the first piece. The corrections are recorded.</p>
        </div>
        <div>
          <div class="feature-num">№ III</div>
          <h3 class="h-3">Reorders</h3>
          <p class="body-prose" style="margin-top: 12px;">Subsequent shirts and trousers can be ordered by phone, by email, by visit. Cloth chosen, collar named, on your back in two to three weeks.</p>
        </div>
        <div>
          <div class="feature-num">№ IV</div>
          <h3 class="h-3">A Body That Changes</h3>
          <p class="body-prose" style="margin-top: 12px;">Annual re-measure. The pattern is amended. Old garments can be brought in for adjustments at any time.</p>
        </div>
      </div>

      <p class="body-prose" data-reveal style="margin-top: 40px; max-width: 60ch;">
        New to custom work? Read
        <a href="/guides/bespoke-vs-made-to-measure-vs-off-the-rack" style="color: var(--ink); border-bottom: 1px solid var(--rule-strong);">bespoke vs made-to-measure</a>
        and
        <a href="/guides/how-a-suit-should-fit" style="color: var(--ink); border-bottom: 1px solid var(--rule-strong);">how a suit should actually fit</a>,
        or explore the <a href="/fabrics" style="color: var(--ink); border-bottom: 1px solid var(--rule-strong);">cloth library</a> before you book.
      </p>
    </div>
  </section>

  <!-- PROOF -->
  <section class="section tight">
    <div class="container">
      <div class="section-head" data-reveal>
        <div class="chapter-no">No. 04</div>
        <h2 class="h-1" style="text-transform: uppercase; max-width: 18ch;">Their first <em>custom suit.</em></h2>
        <div class="right">Unedited &middot; Google reviews</div>
      </div>
      <Testimonials items={[reviews[2], reviews[6], reviews[11]]} />
    </div>
  </section>

  <!-- READING ROOM + FAQ (emits FAQPage schema) -->
  <section class="section tight">
    <div class="container">
      <div class="section-head" data-reveal>
        <div class="chapter-no">No. 05</div>
        <h2 class="h-1" style="text-transform: uppercase; max-width: 20ch;">Before you <em>commission.</em></h2>
        <div class="right">From the notebook</div>
      </div>
      <ul class="prose-list" data-reveal style="margin-top: 28px; max-width: 62rem; columns: 2; column-gap: 56px;">
        <li><a href="/guides/bespoke-vs-made-to-measure-vs-off-the-rack" style="color: var(--oxblood); border-bottom: 1px solid var(--rule-strong);">Bespoke, made-to-measure and off-the-rack</a></li>
        <li><a href="/guides/how-a-suit-should-fit" style="color: var(--oxblood); border-bottom: 1px solid var(--rule-strong);">How a suit should actually fit</a></li>
        <li><a href="/guides/fully-canvassed-vs-fused" style="color: var(--oxblood); border-bottom: 1px solid var(--rule-strong);">Fully canvassed vs fused, and why it matters</a></li>
        <li><a href="/guides/how-to-tell-a-good-suit" style="color: var(--oxblood); border-bottom: 1px solid var(--rule-strong);">How to tell a good suit from a dear one</a></li>
        <li><a href="/guides/choosing-your-cloth" style="color: var(--oxblood); border-bottom: 1px solid var(--rule-strong);">Choosing your cloth</a></li>
        <li><a href="/guides/suits-for-hard-to-fit-bodies" style="color: var(--oxblood); border-bottom: 1px solid var(--rule-strong);">If you have always been hard to fit</a></li>
        <li><a href="/guides/what-to-bring-to-your-first-fitting" style="color: var(--oxblood); border-bottom: 1px solid var(--rule-strong);">What to bring to your first fitting</a></li>
        <li><a href="/guides/how-to-make-a-suit-last-ten-years" style="color: var(--oxblood); border-bottom: 1px solid var(--rule-strong);">Making a suit last ten years</a></li>
      </ul>

      <div class="section-head" data-reveal style="margin-top: clamp(48px, 7vw, 96px);">
        <div class="chapter-no">No. 06</div>
        <h2 class="h-1" style="text-transform: uppercase; max-width: 18ch;">Good to <em>know.</em></h2>
        <div class="right">Straight answers</div>
      </div>
      <div style="max-width: 62rem; margin-top: 28px;" data-reveal><FaqBlock items={customFaqs} /></div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section flush">
    <div class="container">
      <div class="booking-block" data-reveal>
        <div>
          <div class="eyebrow-rule" style="color: var(--gold-soft); margin-bottom: 28px;">
            <span style="background: var(--navy-deep);">Start the pattern</span>
          </div>
          <h2 class="h-1">A first <em>fitting.</em></h2>
          <p class="lede" style="margin-top: 24px;">The first visit takes about ninety minutes. We talk, measure, choose a fabric, draw the collar and cuff together. A shirt is usually ready in two to three weeks, a suit in three to four.</p>
        </div>
        <div class="actions">
          <a href="/book" class="btn is-primary" data-open-booking data-no-transition>Begin the Pattern</a>
          <div class="contact-tag" style="margin-top: 12px;">
            Or call the studio
            <div class="num">647 · 458 · 0711</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />

</BaseLayout>
