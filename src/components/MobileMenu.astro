---
// Full-screen mobile menu drawer. The four houses lead as visual rows (their
// card art), then garments + studio link groups, then a thumb-reach contact
// strip (call / WhatsApp) so the two conversion paths are always one tap away.
const houses = [
  { href: '/wedding', t: 'Wedding', d: 'Groom, groomsmen & fathers', img: '/media/art/house-wedding.webp' },
  { href: '/business', t: 'Business', d: 'Boardroom & everyday', img: '/media/art/house-business.webp' },
  { href: '/custom', t: 'Custom', d: 'Suits & shirts, one pattern', img: '/media/art/house-shirts.webp' },
  { href: '/traditional', t: 'Traditional', d: 'Bekishe, kapota, kittel', img: '/media/art/house-traditional.webp' },
];
---
<aside class="mobile-menu" data-mobile-menu>
  <div class="mobile-menu__head">
    <a href="/" class="brand">Sam<span class="brand__ampersand">'s</span> Menswear</a>
    <button class="nav-toggle" data-menu-close aria-label="Close menu">
      <svg viewBox="0 0 26 26" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
        <line x1="5" y1="5" x2="21" y2="21"/>
        <line x1="21" y1="5" x2="5" y2="21"/>
      </svg>
    </button>
  </div>
  <nav class="mobile-menu__houses" aria-label="Mobile primary">
    {houses.map((h) => (
      <a href={h.href} class="mm-house">
        <span class="mm-house__img"><img src={h.img} alt="" width="112" height="134" loading="lazy"/></span>
        <span class="mm-house__body">
          <span class="mm-house__t">{h.t}</span>
          <span class="mm-house__d">{h.d}</span>
        </span>
        <span class="mm-house__arrow" aria-hidden="true">&rarr;</span>
      </a>
    ))}
    <a href="/book" class="mm-book" data-open-booking data-no-transition><em>Book a</em> Fitting</a>
  </nav>
  <nav class="mobile-menu__secondary" aria-label="Mobile garments">
    <a href="/suits">Suits</a>
    <a href="/tuxedos">Tuxedos</a>
    <a href="/trousers">Trousers</a>
    <a href="/dress-shirts">Dress Shirts</a>
    <a href="/short-sleeve-shirts">Short-Sleeved Shirts</a>
    <a href="/outerwear">Outerwear</a>
    <a href="/casual">Casual &amp; Sport Coats</a>
    <a href="/kapotas">Kapotas &amp; Traditional</a>
    <a href="/kids-teen-suits">Kids &amp; Teen Suits</a>
    <a href="/womens">Women's Suits &amp; Skirts</a>
    <a href="/vegan">Vegan Tailoring</a>
  </nav>
  <nav class="mobile-menu__secondary" aria-label="Mobile secondary">
    <a href="/gift">The Gift of Style</a>
    <a href="/design">Design Your Suit</a>
    <a href="/fabrics">The Cloth Library</a>
    <a href="/guides">Guides</a>
    <a href="/almanac">The Almanac</a>
    <a href="/reviews">Reviews</a>
    <a href="/about">About Sam</a>
    <a href="/process">The Process</a>
    <a href="/journal">Journal</a>
    <a href="/locations">Locations</a>
    <a href="/faq">FAQ</a>
  </nav>
  <div class="mobile-menu__contact">
    <a href="tel:+16474580711" data-no-transition>Call Sam</a>
    <a href="https://wa.me/16474580711?text=Hi%20Sam%20%E2%80%94%20I%27d%20like%20to%20ask%20about%20a%20fitting." target="_blank" rel="noopener" data-no-transition>WhatsApp</a>
  </div>
</aside>
