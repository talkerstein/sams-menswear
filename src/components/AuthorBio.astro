---
// E-E-A-T author box — Sam's real credentials + photo on every guide & journal article.
// Establishes experience, expertise, authority.
const { reviewed = true } = Astro.props;
---
<aside class="author-bio" data-reveal>
  <div class="author-bio__portrait">
    <img src="/media/sam/sam-avatar.webp" alt="Sam Talkar, master tailor, at the Vaughan studio" loading="lazy" width="64" height="64"/>
  </div>
  <div class="author-bio__body">
    <div class="author-bio__k">{reviewed ? 'Written & reviewed by' : 'Written by'}</div>
    <div class="author-bio__name">Sam Talkar <span>· Master Tailor, Vaughan</span></div>
    <p class="author-bio__desc">
      Sam has been at the tailor's bench for over thirty years, the last decade-plus in his own
      studio in Vaughan, on the Thornhill line. Custom and made-to-measure suits, wedding parties
      for the groom, groomsmen and fathers, and traditional Jewish menswear, for men across the
      GTA. Every client is measured and fitted by Sam himself, and every garment is made to those
      measurements, never pulled from a rack.
    </p>
    <div class="author-bio__links">
      <a href="/about">More about Sam</a>
      <span aria-hidden="true">·</span>
      <a href="/reviews">4.7★ · 150+ Google reviews</a>
      <span aria-hidden="true">·</span>
      <a href="/book" data-open-booking data-no-transition>Book a fitting</a>
    </div>
  </div>
</aside>
